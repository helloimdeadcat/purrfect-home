# Supabase — public (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — server only (never expose to the client / never use NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional, server only: public origin used in invitation links
# (recommended in production so links never depend on the Host header).
# APP_URL=https://finance.example.com

# Optional, server only: AI assistant (any OpenAI-compatible endpoint).
# Free Gemini key: https://aistudio.google.com/apikey — without it the
# Assistant page just shows a setup hint.
# AI_API_KEY=your-gemini-key
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-flash-latest
